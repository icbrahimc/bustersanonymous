---
// A single feed item, styled like an X post.
// Props: author {name, handle, avatar}, kicker, headline, detail, meta,
//        pinned (bool), badge (string).
const { author = {}, kicker, headline, detail, meta, pinned = false, badge } = Astro.props;
const initials = (author.name || '?')
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase();

// Plain-text version of the take for the Share button to copy to clipboard —
// paste-ready for the group chat.
const shareText = [
  kicker ? `${kicker}` : null,
  headline,
  detail,
  author.name ? `— ${author.name}${author.handle ? ` (@${author.handle})` : ''} · THE UNDISPUTED BUSTERS TAKE` : null,
]
  .filter(Boolean)
  .join('\n');
---
<article class={`post${pinned ? ' pinned' : ''}`}>
  {pinned && <div class="pin">📌 Pinned storyline</div>}
  <div>
    {author.avatar ? (
      <img class="avatar" src={author.avatar} alt="" loading="lazy" width="44" height="44" />
    ) : (
      <span class="avatar">{initials}</span>
    )}
  </div>
  <div class="post-main">
    <div class="post-meta">
      <span class="name">{author.name}</span>
      <span class="handle">@{author.handle}</span>
      {meta && <><span class="dot">·</span><span class="time">{meta}</span></>}
      {badge && <span class="badge gold" style="margin-left:6px;">{badge}</span>}
    </div>
    {kicker && <span class="post-kicker">{kicker}</span>}
    {headline && <p class="post-headline">{headline}</p>}
    {detail && <p class="post-body">{detail}</p>}
    <div class="post-actions">
      <span>💬 League chat</span>
      <span class="share-btn" role="button" tabindex="0" data-share={shareText} aria-label="Copy this take to clipboard">🔁 Share</span>
      <span>📊 Stats</span>
    </div>
  </div>
</article>

<style>
  .share-btn { cursor: pointer; transition: color 0.15s ease; }
  .share-btn:hover { color: var(--text); }
  .share-btn.copied { color: #16a34a; }
</style>

<script>
  // Copy a take's text to the clipboard when its Share button is used. One
  // delegated listener covers every Post on the page (feed, history, etc.).
  async function copyShare(el: HTMLElement) {
    const text = el.getAttribute('data-share');
    if (!text) return;
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
      } else {
        // Fallback for older / non-secure contexts.
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const original = el.textContent;
      el.classList.add('copied');
      el.textContent = '✅ Copied';
      window.setTimeout(() => {
        el.textContent = original;
        el.classList.remove('copied');
      }, 1400);
    } catch {
      el.textContent = '⚠️ Press Ctrl+C';
      window.setTimeout(() => (el.textContent = '🔁 Share'), 1600);
    }
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement)?.closest('.share-btn');
    if (btn) copyShare(btn as HTMLElement);
  });
  // Keyboard access: Enter / Space on the focused Share button.
  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (!target?.classList?.contains('share-btn')) return;
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      copyShare(target);
    }
  });
</script>
