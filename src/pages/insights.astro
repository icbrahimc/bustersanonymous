---
import Base from '../layouts/Base.astro';
import Post from '../components/Post.astro';
import StandingsWidget from '../components/StandingsWidget.astro';
import StandingsTable from '../components/StandingsTable.astro';
import ArchiveWidget from '../components/ArchiveWidget.astro';
import league from '../data/league.json';
import standingsData from '../data/standings.json';
import feed from '../data/feed.json';
import { hasPlayed } from '../lib/insights.js';

const standings = standingsData.standings || [];
// AI-generated hot takes (built server-side in the daily cron → feed.json).
const storylines = feed.posts || [];

const seasonStarted = hasPlayed(standings);
const weekLabel = seasonStarted ? 'Season to date' : 'Preseason';
---
<Base page="insights" title="Weekly Insights" description="Storylines and standings for the current week.">
  <div class="layout">
    <div>
      <div class="feed-head">
        <h1>Weekly Insights</h1>
        <p class="sub">The Daily Take{feed.date ? ` · ${feed.date}` : ''} · refreshed every day</p>
        <div class="tabs">
          <span class="tab active">{weekLabel}</span>
          {!seasonStarted && <span class="tab">Weeks unlock at kickoff</span>}
        </div>
      </div>

      <div class="feed">
        {storylines.map((s) => <Post {...s} />)}
      </div>

      <section class="widget" style="margin-top:20px;">
        <h2>Full Standings</h2>
        {standings.length ? (
          <div style="padding: 0 8px 8px;"><StandingsTable rows={standings} /></div>
        ) : (
          <p class="empty">Standings will appear once rosters are finalized.</p>
        )}
      </section>
    </div>

    <aside class="sidebar">
      <StandingsWidget rows={standings} title="Standings" limit={6} moreHref="/insights" moreLabel="See all teams" />
      <ArchiveWidget current={feed.date} title="Past Editions" />
    </aside>
  </div>
</Base>
