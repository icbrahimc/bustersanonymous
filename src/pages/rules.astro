---
import Base from '../layouts/Base.astro';
import { Content, getHeadings, frontmatter } from '../content/rules.md';

const toc = getHeadings().filter((h) => h.depth === 2);
const amended = frontmatter.lastAmended;
---
<Base page="rules" title="Rules" description="The official league rulebook.">
  <div class="layout">
    <div>
      <div class="feed-head">
        <h1>Rulebook</h1>
        <p class="sub">The official rules of the league{amended ? ` · last amended ${amended}` : ''}</p>
      </div>
      <article class="prose" style="padding-top:18px;">
        <Content />
      </article>
    </div>

    <aside class="sidebar">
      <section class="widget">
        <h2>Contents</h2>
        <nav class="quick-links">
          {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
        </nav>
      </section>
    </aside>
  </div>
</Base>
