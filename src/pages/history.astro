---
import Base from '../layouts/Base.astro';
import Post from '../components/Post.astro';
import StandingsTable from '../components/StandingsTable.astro';
import allTime from '../data/all-time.json';
import history from '../data/history.json';

const seasons = history.seasons || [];
const champions = seasons.filter((s) => s.champion);
const records = allTime.records || {};
const mostTitles = records.mostTitles || [];
const topTitle = mostTitles[0];
const defaultSeason = seasons[0]?.season;

const handle = (name = '') => name.replace(/[^a-zA-Z0-9_]/g, '');
---
<Base page="history" title="History" description="Champions, all-time records, and past season standings.">
  <div class="layout">
    <div>
      <div class="feed-head">
        <h1>History</h1>
        <p class="sub">Every champion and the all-time record book</p>
        <div class="tabs">
          <span class="tab active">Champions</span>
          <span class="tab">Records</span>
        </div>
      </div>

      <div class="feed">
        {champions.length ? (
          champions.map((s) => (
            <Post
              author={{ name: s.champion.teamName, handle: handle(s.champion.manager), avatar: s.champion.avatar }}
              meta={`${s.season} Season`}
              kicker={`${s.season} Champion`}
              headline={`${s.champion.teamName} won it all 🏆`}
              detail={`${s.champion.manager} took home the ring in ${s.season}.`}
              badge={`🏆 ${s.season}`}
            />
          ))
        ) : (
          <p class="empty">No completed seasons yet — the first champion will be crowned this year.</p>
        )}
      </div>

      <section class="widget" style="margin-top:20px;">
        <h2>Season Standings</h2>
        {seasons.length ? (
          <div style="padding: 4px 8px 8px;">
            <div class="selector" data-season-selector>
              {seasons.map((s) => (
                <button class:list={['btn', { active: s.season === defaultSeason }]} data-season-btn={s.season}>
                  {s.season}
                </button>
              ))}
            </div>
            {seasons.map((s) => (
              <div data-season-panel={s.season} style={s.season === defaultSeason ? '' : 'display:none;'}>
                <StandingsTable rows={s.standings} />
              </div>
            ))}
          </div>
        ) : (
          <p class="empty">No seasons to show yet.</p>
        )}
      </section>
    </div>

    <aside class="sidebar">
      <section class="widget">
        <h2>All-Time Records</h2>
        <div class="w-row">
          <span class="w-team">
            <span class="name">Most points (season)</span>
            <span class="sub">{records.mostPF ? `${records.mostPF.teamName} · ${records.mostPF.season}` : '—'}</span>
          </span>
          <span class="badge">{records.mostPF ? records.mostPF.fpts.toFixed(0) : '—'}</span>
        </div>
        <div class="w-row">
          <span class="w-team">
            <span class="name">Most wins (season)</span>
            <span class="sub">{records.mostWins ? `${records.mostWins.teamName} · ${records.mostWins.season}` : '—'}</span>
          </span>
          <span class="badge">{records.mostWins ? `${records.mostWins.wins}W` : '—'}</span>
        </div>
        <div class="w-row">
          <span class="w-team">
            <span class="name">Most titles</span>
            <span class="sub">{topTitle ? topTitle.manager : 'Up for grabs'}</span>
          </span>
          <span class="badge gold">{topTitle ? `${topTitle.count} 🏆` : '—'}</span>
        </div>
      </section>
    </aside>
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll('[data-season-btn]');
  const panels = document.querySelectorAll('[data-season-panel]');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const season = btn.getAttribute('data-season-btn');
      buttons.forEach((b) => b.classList.toggle('active', b === btn));
      panels.forEach((p) => {
        p.style.display = p.getAttribute('data-season-panel') === season ? '' : 'none';
      });
    });
  });
</script>
