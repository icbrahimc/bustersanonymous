---
import Base from '../layouts/Base.astro';
import Post from '../components/Post.astro';
import StandingsWidget from '../components/StandingsWidget.astro';
import { href } from '../lib/url.js';
import league from '../data/league.json';
import standingsData from '../data/standings.json';
import history from '../data/history.json';
import feed from '../data/feed.json';

const standings = standingsData.standings || [];
const lastCompleted = history.seasons.find((s) => s.status === 'complete');
const lastChampion = lastCompleted?.champion || null;

// AI-generated hot takes (built server-side in the daily cron → feed.json).
const storylines = feed.posts || [];

const statusLabel =
  {
    pre_draft: 'Pre-Draft',
    drafting: 'Draft in Progress',
    in_season: 'In Season',
    complete: 'Season Complete',
  }[league.status] || league.status;
---
<Base page="home" title="Home" description={`${league.name} — the official league feed.`}>
  <div class="layout">
    <div>
      <div class="feed-head">
        <h1>Home</h1>
        <p class="sub">{league.name} · {league.season} · {statusLabel}</p>
        <div class="tabs">
          <span class="tab active">For You</span>
          <span class="tab">Latest</span>
        </div>
      </div>

      <div class="feed">
        {storylines.map((s, i) => (
          <Post
            {...s}
            pinned={i === 0}
            badge={i === 0 && lastChampion ? '🏆 Reigning Champ' : undefined}
          />
        ))}
      </div>
    </div>

    <aside class="sidebar">
      <StandingsWidget rows={standings} title="Standings" moreHref="/insights" />
      <section class="widget">
        <h2>League</h2>
        <nav class="quick-links">
          <a href={href('/rules')}>📕 Rulebook</a>
          <a href={href('/history')}>🏆 Champions & Records</a>
          <a href={href('/insights')}>📊 Weekly Insights</a>
        </nav>
      </section>
    </aside>
  </div>
</Base>
